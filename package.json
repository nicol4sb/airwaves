{
  "name": "airwave",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --config client/vite.config.ts\" ",
    "start": "tsx server/index.ts",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build --config client/vite.config.ts && node scripts/sw.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.0",
    "idb": "^8.0.3",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "multicast-dns": "^7.2.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.2.0",
    "fake-indexeddb": "^6.2.8",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^5.1.1"
  }
}
